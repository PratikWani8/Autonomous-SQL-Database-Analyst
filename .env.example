# ==============================================================================
# AUTONOMOUS SQL DATABASE ANALYST - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NODE.JS SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/autonomous_sql_analyst
JWT_SECRET=super_secure_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Internal AI Service communication
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=internal_service_secret_token_12345

# ------------------------------------------------------------------------------
# 2. PYTHON FASTAPI AI SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
INTERNAL_SERVICE_KEY=internal_service_secret_token_12345

# Dedicated READ-ONLY PostgreSQL Connection (MANDATORY for query execution)
# Note: Never use a superuser or write-capable user for analytical queries.
DATABASE_URL=postgresql://analyst_readonly:readonly_secure_pass123@localhost:5432/indian_public_data

# Admin PostgreSQL connection (used solely by database migration and seed scripts)
DATABASE_ADMIN_URL=postgresql://postgres:password@localhost:5432/indian_public_data

# LLM Provider Configuration: 'deterministic', 'gemini', 'openai', 'groq', 'ollama'
LLM_PROVIDER=deterministic
LLM_MODEL=gemini-1.5-pro
LLM_API_KEY=your_optional_llm_api_key_here
LLM_TIMEOUT_SECONDS=30

# SQL Safety & Runtime Safeguards
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_MAX_ROWS=500
MAX_CORRECTION_ATTEMPTS=2

# ------------------------------------------------------------------------------
# 3. REACT CLIENT CONFIGURATION (VITE)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
